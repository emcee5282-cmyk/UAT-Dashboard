TELEGRAM_BOT_TOKEN=

SBO_BO_URL=https://sbomcwgroup.net/page/mmg/payment/deposit.jsp
SBO_BO_USERNAME=
SBO_BO_PASSWORD=

# Comma-separated Telegram chat IDs allowed to send approvals (send /chatid in the group to get it)
ALLOWED_CHAT_IDS=

# true = bypass ALLOWED_CHAT_IDS entirely, ANY Telegram chat can trigger a
# search/approval. Explicit opt-in only — leave false/unset unless you mean it.
ALLOW_ALL_CHATS=false

# Shared secret every approval request must include as "Secret Key: ...".
# A request with a missing/wrong key is silently ignored — never echoed
# back in any reply, never written in full to approvals.log. Leaving this
# unset means EVERY request is rejected (fail closed).
SECURITY_CODE=

# Posted a structured JSON summary after every real APPROVED makeup deposit.
# Leave blank to skip (optional).
WEBHOOK_URL=

# HTTP endpoint (POST /approve, same text format + Secret Key as a Telegram
# message) for a sender Telegram blocks from reaching this bot directly —
# another bot account posting in the same group. Leave blank to disable.
HTTP_PORT=

# Optional — a Telegram chat/group ID the bot also posts each HTTP-triggered
# result into (get it via /chatid in that chat). Leave blank to skip.
HTTP_REPLY_CHAT_ID=



# false = show the browser window (useful for first login / debugging)
HEADLESS=true

# Milliseconds to pause between browser actions (e.g. 500 to watch it step by step). 0 = full speed.
SLOW_MO=0
