# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# deploy packaging
/deploy-*.tar.gz

# typescript
*.tsbuildinfo
next-env.d.ts
.playwright-mcp/

# standalone bot processes (bots/*/ — own package.json, never imported by
# the Next.js app) — real credentials, persisted browser sessions, and
# per-run logs stay local-only; the committed .env.example template is
# exempted from the global .env* ignore above so it still ships with the
# bot folder.
bots/**/.env
!bots/**/.env.example
bots/**/browser-data/
bots/**/approvals.log
bots/**/node_modules
# inspect-page.js's own generated output (inspect-deposit.png/.txt,
# inspect-makeup.png/.txt) — NOT inspect-page.js itself, the source script,
# which the bare "inspect-*" pattern would otherwise also catch.
bots/**/inspect-*
!bots/**/inspect-*.js
